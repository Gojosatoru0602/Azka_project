import asyncio
import aiohttp
import os
from PyroUbot import *

__MODULE__ = "sᴘᴏᴛɪғʏ"
__HELP__ = """
<blockquote><b>Bantuan Untuk Spotify</b>

Perintah:
<code>{0}spotify</code> [judul lagu] → Download lagu dari Spotify.</blockquote></b>
"""

@PY.UBOT("spotify")
@PY.TOP_CMD
async def _(client, message):
    if len(message.command) < 2:
        return await message.reply_text("<blockquote><b>📖 PANDUAN (PEMULA)</b>\n\nGunakan format: <code>.spotify judul lagu</code></blockquote>")
    
    query = message.text.split(None, 1)[1]
    status_msg = await message.reply_text("<blockquote><b>🔍 Sedang mencari lagu di Spotify...</b></blockquote>")
    
    # Gunakan aiohttp agar ubot tidak lag saat download
    async with aiohttp.ClientSession() as session:
        try:
            # Step 1: Search
            search_api = f"https://api.botcahx.eu.org/api/search/spotify?query={query}&apikey=_@moire_mor"
            async with session.get(search_api) as resp:
                search_data = await resp.json()
            
            if not search_data.get("status") or not search_data["result"]["data"]:
                return await status_msg.edit("<blockquote><b>❌ Lagu tidak ditemukan.</b></blockquote>")
            
            track_url = search_data["result"]["data"][0]["url"]
            
            # Step 2: Download Info
            await status_msg.edit("<blockquote><b>📥 Sedang mengunduh audio...</b></blockquote>")
            dl_api = f"https://api.botcahx.eu.org/api/download/spotify?url={track_url}&apikey=_@moire_mor"
            async with session.get(dl_api) as resp:
                dl_data = await resp.json()
            
            if not dl_data.get("status"):
                return await status_msg.edit("<blockquote><b>❌ Gagal mengambil link download.</b></blockquote>")
            
            res = dl_data["result"]["data"]
            file_url = res["url"]
            file_name = f"{res['title']}.mp3"
            
            # Step 3: Streaming Download ke File Lokal
            async with session.get(file_url) as audio_resp:
                if audio_resp.status != 200:
                    return await status_msg.edit("<blockquote><b>❌ Server API menolak akses (403/500).</b></blockquote>")
                
                with open(file_name, "wb") as f:
                    f.write(await audio_resp.read())

            # Step 4: Kirim
            await client.send_audio(
                message.chat.id,
                audio=file_name,
                caption=(
                    f"<blockquote><b>🎵 SPOTIFY DOWNLOADER</b>\n\n"
                    f"<b>🎶 Judul:</b> <code>{res['title']}</code>\n"
                    f"<b>👤 Artis:</b> <code>{res['artist']['name']}</code>\n"
                    f"<b>⏳ Durasi:</b> <code>{res['duration']}</code>\n\n"
                    f"<b>🎧 <a href='{res['artist']['external_urls']['spotify']}'>Buka di Spotify</a></b></blockquote>"
                )
            )
            
            await status_msg.delete()
            if os.path.exists(file_name):
                os.remove(file_name)

        except Exception as e:
            await status_msg.edit(f"<blockquote><b>⚠️ Terjadi Kesalahan:</b>\n<code>{str(e)}</code></blockquote>")
            